{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_instructions.py\"",
            "timeout": 10,
            "statusMessage": "Orchestrator instructions"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/remind_chair.py\"",
            "timeout": 10,
            "statusMessage": "Orchestrator reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task|Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/solo_guard.py\"",
            "timeout": 10,
            "statusMessage": "Solo guard"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/cleanup_session_cache.py\"",
            "timeout": 20,
            "statusMessage": "Orchestrator cleanup (cache + teammates)"
          }
        ]
      }
    ]
  }
}
